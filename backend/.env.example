# Copy to .env and fill in real values. Never commit the real .env file.

PORT=4000

# Neon connection string (pooled connection recommended for serverless/Render)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Secret used to sign both registration-session and login JWTs.
# Generate a strong random value, e.g.: openssl rand -hex 32
JWT_SECRET=

REGISTRATION_JWT_EXPIRES_IN=15m
LOGIN_JWT_EXPIRES_IN=24h

# Mailtrap Email Testing sandbox SMTP credentials (NOT the Sending product —
# see project notes: host should be sandbox.smtp.mailtrap.io, not live.smtp.mailtrap.io)
# Render deploys may provide these as either MAILTRAP_* or SMTP_* values.
MAILTRAP_HOST=sandbox.smtp.mailtrap.io
MAILTRAP_PORT=2525
MAILTRAP_USER=
MAILTRAP_PASS=

EMAIL_FROM=Loan Servicing <no-reply@loanservicing.demo>

# Frontend origin for CORS (Vercel URL in production)
CORS_ORIGIN=*

# Set to "false" only for local dev against a Postgres instance with no SSL
# configured. Neon requires SSL, so this should stay unset/true in deploy.
# DB_SSL=false
